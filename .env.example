# 결제 모드. 기본은 local(scripts/local_chain.py 로 띄운 이 컴퓨터의 anvil). Base Sepolia 전송은 두 줄이 모두 있어야 시작된다.
AEGIS_PAYMENT_MODE=local
AEGIS_REAL_PAYMENT_APPROVED=no

# local 에서 쓰는 로컬 체인 주소. 이 컴퓨터 주소만 받는다. 자동 테스트(pytest)는 8546 을 따로 쓴다.
AEGIS_LOCAL_RPC_URL=http://127.0.0.1:8545

# live 에서 쓰는 Base Sepolia AEGIS 토큰 (ERC-20, 소수점 6자리). local 은 이 값을 쓰지 않는다.
# 아래 주소는 transferWithAuthorization(ERC-3009) 이 없는 이전 토큰이다. live 는 contracts/ 의 새 토큰을 배포한 뒤 그 주소로 바꿔야 동작한다.
AEGIS_TOKEN_ADDRESS=0xE208f63B826FcDD9De0836EFFEb0FA49d1c4142b
AEGIS_CHAIN_ID=84532
AEGIS_RPC_URL=https://sepolia.base.org

# live 구매자 지갑의 개인키. 결제 내용에 서명만 하므로 이 지갑에 ETH 는 필요 없다.
# 값은 여기에 적지 말고 .env.local 에만 넣는다. local 은 anvil 공개 테스트 계정을 쓴다.
AEGIS_BUYER_PRIVATE_KEY=

# live 중개자 지갑의 개인키. 구매자 서명을 실어 결제 거래를 보내고 가스비를 낸다. 값은 .env.local 에만 넣는다.
# 운영자(토큰 배포·발급) 지갑과 다른, 가스비용 ETH 만 넣은 새 지갑을 쓴다.
AEGIS_RELAYER_PRIVATE_KEY=

# Artificial Analysis API 키. 벤치마크 자동 갱신에 쓴다. 값은 .env.local 에만 넣는다.
AA_API_KEY=

# 우선순위가 빈 요청에서 우선순위를 추론할 로컬 Ollama. 루프백 주소만 받는다.
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_MODEL=qwen3.5:4b
AEGIS_OLLAMA_TIMEOUT_SECONDS=30

# 기록 저장소. 로컬 MongoDB에 이 프로젝트 전용 데이터베이스를 쓴다.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=agent_m2m

# 화면(web/)이 부르는 Python 서버 주소. 화면 쪽에서만 읽는다.
AGENT_M2M_API_URL=http://127.0.0.1:8000

# 감사 규칙 replay(agent_m2m/rules/replay.py): 서버가 요청 번호를 기억하는 시간(초). 지나면 새 요청으로 본다.
AUDIT_REQUEST_ID_TTL_SECONDS=86400
# 기록을 남기기 전에 끝난 요청(400·503, 서버 중단)의 요청 번호를 다시 받기까지 기다리는 시간(초). AEGIS_OLLAMA_TIMEOUT_SECONDS 보다 길게 둔다.
AUDIT_REQUEST_ID_LEASE_SECONDS=120
# 감사 규칙 repeat-prompt: 한 사용자가 같은 문장을 AUDIT_REPEAT_WINDOW_SECONDS 초 안에 AUDIT_REPEAT_COUNT 번 보내면 멈추고 사용자 확인(409).
AUDIT_REPEAT_COUNT=3
AUDIT_REPEAT_WINDOW_SECONDS=60
