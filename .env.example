# 결제가 가는 로컬 체인(scripts/local_chain.py 로 띄운 이 컴퓨터의 anvil) 주소. 이 컴퓨터 주소만 받는다. 자동 테스트(pytest)는 8546 을 따로 쓴다.
AEGIS_LOCAL_RPC_URL=http://127.0.0.1:8545

# 우선순위가 빈 요청에서 우선순위를 추론할 로컬 Ollama. 루프백 주소만 받는다.
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_MODEL=gemma4:12b
AEGIS_OLLAMA_TIMEOUT_SECONDS=30

# 기록 저장소. 로컬 MongoDB에 이 프로젝트 전용 데이터베이스를 쓴다.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=agent_m2m

# 화면(web/)이 부르는 Python 서버 주소. 화면 쪽에서만 읽는다.
AGENT_M2M_API_URL=http://127.0.0.1:8000

# 감사 규칙 limit(시나리오 1): 1건 상한과 하루 상한(AEGIS 단위). 하루는 UTC 기준.
AUDIT_LIMIT_PER_PAYMENT=0.5
AUDIT_LIMIT_PER_DAY=3
AUDIT_LIMIT_WARN_RATIO=0.8

# 감사 규칙 duplicate-purchase: 한 사용자가 같은 문장으로 같은 모델을 AUDIT_REPEAT_WINDOW_SECONDS 초 안에 AUDIT_REPEAT_COUNT 번째 사려 하면 송금 직전에 막는다.
AUDIT_REPEAT_COUNT=3
AUDIT_REPEAT_WINDOW_SECONDS=60

# 감사 규칙 holdout(시나리오 ①): 비교한 곳과의 흥정이 모두 결렬된 뒤 예산을 넘는 값에 사려 하면 송금 직전에 막는다.
# AUDIT_HOLDOUT_TOLERANCE_RATIO 는 막지 않고 허용할 예산 초과 비율(0 이면 예산 초과는 모두 막음).
AUDIT_HOLDOUT_TOLERANCE_RATIO=0
# 결렬된 판매자의 마지막 N번 제안이 같으면 "값을 안 내림" 알림(holdout-stall).
AUDIT_HOLDOUT_STALL_ROUNDS=3
# 판매자별 최근 WINDOW 건 중 예산 초과 비율이 RATIO 이상이면 알림(holdout-seller-rate). MIN_DEALS 건 전에는 알리지 않음.
AUDIT_HOLDOUT_SELLER_WINDOW=10
AUDIT_HOLDOUT_SELLER_MIN_DEALS=3
AUDIT_HOLDOUT_SELLER_RATIO=0.3

# 감사 규칙 persona-gap(시나리오 2): 페르소나(품질형 등)로 산 값이 기본 페르소나(최저가형)로 같은 흥정을 다시 계산한 값보다 이 비율 이상 비싸면 검사한다(0 초과 1 이하, 최저가형 값 기준).
# 막지 않고 알림만 남긴다. 최저가형 값과의 비교는 모든 구매의 거래 평가에 "최저가 근거"로 남는다.
AUDIT_PERSONA_GAP_RATIO=0.05

# 감사 규칙 seller-collusion(시나리오 ③ 판매자 담합): 결제 후 알림만 남긴다. 같은 흥정을 판매자가 최저가 비율
# AUDIT_COLLUSION_REFERENCE_FLOOR 로 응했다면 받았을 값을 기준선으로 다시 계산하고, 등급별 최근 AUDIT_COLLUSION_WINDOW 건을 본다.
# 가격 맞추기: 비교한 판매자 중 2곳 이상이 기준보다 호가 대비 평균 AUDIT_COLLUSION_GAP 이상 더 받음.
# 같이 오름: 판매자 중 2곳 이상이 그 차이가 앞 N건보다 AUDIT_COLLUSION_RISE 이상 커짐.
# 시장 나누기: 가격 맞추기가 걸린 두 등급에서 최근 N건 중 AUDIT_COLLUSION_SHARE 이상을 이긴 판매자가 서로 다름.
AUDIT_COLLUSION_REFERENCE_FLOOR=0.8
AUDIT_COLLUSION_WINDOW=5
AUDIT_COLLUSION_GAP=0.1
AUDIT_COLLUSION_RISE=0.05
AUDIT_COLLUSION_SHARE=0.8

# x402 판매창구 주소. 구매 에이전트가 이 주소의 /api/provider/purchases/{구매 번호} 로 402 를 주고받는다. 기본은 이 서버 자신.
# AGENT_M2M_PROVIDER_URL=http://127.0.0.1:8000
