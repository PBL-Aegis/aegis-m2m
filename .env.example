# 결제가 가는 로컬 체인(scripts/local_chain.py 로 띄운 이 컴퓨터의 anvil) 주소. 이 컴퓨터 주소만 받는다. 자동 테스트(pytest)는 8546 을 따로 쓴다.
AEGIS_LOCAL_RPC_URL=http://127.0.0.1:8545

# 우선순위가 빈 요청에서 우선순위를 추론할 로컬 Ollama. 루프백 주소만 받는다.
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_OLLAMA_MODEL=gemma4:12b
AEGIS_OLLAMA_TIMEOUT_SECONDS=30

# 감사 규칙 unintended-upgrade(시나리오 3): 우선순위를 Gemma 가 정했을 때 사용자 확인 없이 살 수 있는 가장 높은 등급.
# price < default < intelligence. 이보다 높은 등급을 사게 되면 송금 직전에 막는다.
AUDIT_UPGRADE_MAX_PRIORITY=default

# 기록 저장소. 로컬 MongoDB에 이 프로젝트 전용 데이터베이스를 쓴다.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=agent_m2m

# 화면(web/)이 부르는 Python 서버 주소. 화면 쪽에서만 읽는다.
AGENT_M2M_API_URL=http://127.0.0.1:8000

# 감사 규칙 limit(시나리오 1): 1건 상한과 하루 상한(AEGIS 단위). 하루는 UTC 기준.
AUDIT_LIMIT_PER_PAYMENT=0.5
AUDIT_LIMIT_PER_DAY=3
AUDIT_LIMIT_WARN_RATIO=0.8

# 감사 규칙 duplicate-purchase: 한 사용자가 같은 문장으로 같은 모델을 AUDIT_REPEAT_WINDOW_SECONDS 초 안에 AUDIT_REPEAT_COUNT 번째 사려 하면 송금 직전에 막는다.
AUDIT_REPEAT_COUNT=3
AUDIT_REPEAT_WINDOW_SECONDS=60
